{
  "name": "vw-gui",
  "version": "1.0.0",
  "description": "Desktop front-end for the vw PowerShell CLI. Browse the command registry, fill parameters, pick a working directory, and watch output stream. Styled in vaultwares-square.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "vaultwares",
    "powershell",
    "cli",
    "electron"
  ],
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.vaultwares.vwgui",
    "productName": "vw-gui",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**",
      "js/**",
      "fonts/**",
      "scripts/**",
      "build/*.png",
      "build/*.ico",
      "node_modules/**"
    ],
    "asarUnpack": [
      "scripts/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vw-gui",
      "artifactName": "vw-gui-setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@41.10.3": true,
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
